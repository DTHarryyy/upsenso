{
  "configurations": [
    {
      "name": "POS (dev)",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define-from-file=${workspaceFolder}/flavors/dev.json"]
    },
    {
      "name": "POS Web (dev)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "cwd": "${workspaceFolder}",
      "args": [
        "--dart-define-from-file=${workspaceFolder}/flavors/dev.json",
        "--web-port=3000"
      ]
    }
  ]
}
