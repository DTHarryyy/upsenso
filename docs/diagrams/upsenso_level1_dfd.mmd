%% UPSENSO — Level-1 Data Flow Diagram
%% Classic DFD notation (Gane-Sarson / Yourdon) emulated in Mermaid:
%%   rectangle = external entity, circle = process (numbered), cylinder = data store (Dn).
%% DFDs show DATA flows only. Control/authorization (Access Control gating processes
%% 1-4 & 8) and sync reconciliation are described in README.md, not drawn as arrows,
%% to keep the figure readable. Store contents (backing tables) are also in README.md.
flowchart LR
    %% ================= External entities =================
    CASHIER["Cashier /<br/>POS Staff"]
    CUSTOMER["Customer"]
    MANAGER["Branch<br/>Manager"]
    OWNER["Owner /<br/>Super Admin"]
    SUPPLIER["Supplier"]
    CLOUD["Supabase<br/>Cloud Backend"]

    %% ================= Processes =================
    P1(("1<br/>Point of<br/>Sale"))
    P2(("2<br/>Inventory &amp;<br/>Stock"))
    P3(("3<br/>Procurement"))
    P4(("4<br/>Expense<br/>Mgmt"))
    P5(("5<br/>Access<br/>Control"))
    P6(("6<br/>Audit &amp;<br/>Fraud"))
    P7(("7<br/>Sync<br/>Engine"))
    P8(("8<br/>Reporting<br/>&amp; AI"))

    %% ================= Data stores (contents in README) =================
    D1[("D1<br/>Sales &amp; Payments")]
    D2[("D2<br/>Products &amp; Inventory")]
    D3[("D3<br/>Procurement")]
    D4[("D4<br/>Expenses")]
    D5[("D5<br/>Org, Roles &amp; Modules")]
    D6[("D6<br/>Audit &amp; Fraud")]
    D7[("D7<br/>Sync &amp; Devices")]

    %% ---------- POS (P1) ----------
    CASHIER -- "cart, payment" --> P1
    CUSTOMER -- "order, payment" --> P1
    P1 -- "receipt" --> CUSTOMER
    P1 -- "sale / refund" --> D1
    D2 -- "prices" --> P1
    P1 -- "items sold" --> P2

    %% ---------- Inventory (P2) ----------
    MANAGER -- "stock adjust" --> P2
    P2 -- "levels, ledger" --> D2
    P3 -- "received stock" --> P2

    %% ---------- Procurement (P3) ----------
    MANAGER -- "create PO" --> P3
    P3 -- "purchase order" --> SUPPLIER
    SUPPLIER -- "goods (GRN)" --> P3
    P3 -- "PO / GRN" --> D3

    %% ---------- Expenses (P4) ----------
    CASHIER -- "submit expense" --> P4
    MANAGER -- "approve / reject" --> P4
    P4 -- "expense" --> D4

    %% ---------- Access Control (P5) ----------
    OWNER -- "role / module config" --> P5
    P5 -- "roles, overrides" --> D5

    %% ---------- Audit & Fraud (P6) ----------
    P1 -- "audit" --> P6
    P2 -- "audit" --> P6
    P3 -- "audit" --> P6
    P4 -- "audit" --> P6
    P6 -- "log, flags" --> D6
    P6 -- "fraud alert" --> MANAGER

    %% ---------- Offline Sync Engine (P7) ----------
    P1 -- "queue" --> P7
    P2 -- "queue" --> P7
    P3 -- "queue" --> P7
    P4 -- "queue" --> P7
    P6 -- "outbox" --> P7
    P7 -- "state" --> D7
    P7 -- "push" --> CLOUD
    CLOUD -- "deltas" --> P7

    %% ---------- Reporting & AI (P8) ----------
    MANAGER -- "query" --> P8
    OWNER -- "query" --> P8
    P8 -- "reports, dashboards" --> OWNER
    D1 -- "read" --> P8
    D6 -- "read" --> P8

    %% ================= Styling =================
    classDef entity fill:#e8eef7,stroke:#33475b,stroke-width:1.5px,color:#1b2a3a;
    classDef process fill:#d6ebd6,stroke:#2f6b2f,stroke-width:2px,color:#173417;
    classDef store fill:#fdf3d8,stroke:#9a7b1e,stroke-width:1.5px,color:#4a3a08;
    class CASHIER,CUSTOMER,MANAGER,OWNER,SUPPLIER,CLOUD entity;
    class P1,P2,P3,P4,P5,P6,P7,P8 process;
    class D1,D2,D3,D4,D5,D6,D7 store;
